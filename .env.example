# Copy to .env.local and fill in. .env.local is git-ignored.

# --- Database (Neon Postgres) ---
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# --- App ---
# Public base URL, used to build Stripe success/cancel redirect URLs.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# --- Stripe (test mode) ---
# Secret key from the Stripe dashboard (test mode: sk_test_...).
STRIPE_SECRET_KEY="sk_test_..."
# Webhook signing secret. Local: from `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- AI providers ---
# Which provider the AI service uses: "openai" | "gemini".
AI_PROVIDER="openai"
OPENAI_API_KEY="sk-..."
GOOGLE_GEMINI_API_KEY="..."
